# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. Supabase PostgreSQL Configuration
# Found in: Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# Optional: Supabase Service Role Key for server-side verification scripts
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Edge Functions URL if using Supabase Cloud backend
# VITE_SUPABASE_FUNCTIONS_URL=https://your-project.functions.supabase.co

# 2. Google reCAPTCHA v2 Keys
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here


